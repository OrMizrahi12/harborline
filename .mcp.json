{
  "mcpServers": {
    "harborline": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "mcp_server.server"
      ],
      "env": {
        "HARBORLINE_API_TOKEN": "${HARBORLINE_API_TOKEN}"
      }
    },
    "codemap": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "devtools.codemap_server"
      ]
    }
  }
}
