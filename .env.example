# Copy this file to .env and paste your own Anthropic API key after the '='.
# .env is listed in .gitignore, so git never commits it.
ANTHROPIC_API_KEY=

# harborline-mcp's backend token. .mcp.json reads it from your environment
# as ${HARBORLINE_API_TOKEN}. Harborline's local tokens start with hl_.
HARBORLINE_API_TOKEN=
